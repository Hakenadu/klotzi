# ─── Discord ────────────────────────────────────────────────
# https://discord.com/developers/applications → deine App
DISCORD_TOKEN=                 # Bot → Reset Token
DISCORD_CLIENT_ID=             # OAuth2 → Client ID
DISCORD_CLIENT_SECRET=         # OAuth2 → Client Secret (für die Activity nötig)
# Optional: Slash-Commands nur in dieser Guild registrieren (sofort verfügbar, ideal zum Entwickeln)
DISCORD_GUILD_ID=

# ─── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Obergrenze für Ausgabe-Tokens inkl. Reasoning
# OPENAI_MAX_TOKENS=2000
# Reasoning-Aufwand: none, minimal, low, medium, high … (leer = Modell-Standard)
# OPENAI_REASONING_EFFORT=low
# OPENAI_BASE_URL=             # für kompatible APIs / Proxys

# ─── Klotzis Verhalten ──────────────────────────────────────
# Kanäle (IDs, kommagetrennt), in denen Klotzi auf JEDE Nachricht antwortet
KLOTZI_CHAT_CHANNELS=
# Reagiert, wenn "Klotzi" in einer Nachricht vorkommt
KLOTZI_RESPOND_TO_NAME=true
# Wahrscheinlichkeit für spontane Reaktionen (Emoji + Animation) auf andere Nachrichten
KLOTZI_AMBIENT_CHANCE=0.15
KLOTZI_AMBIENT_COOLDOWN=60
KLOTZI_HISTORY_LIMIT=15
KLOTZI_USER_COOLDOWN=3

# ─── Skills ─────────────────────────────────────────────────
# Nur diese Skills laden (leer = alle)
KLOTZI_SKILLS=
# Diese Skills nicht laden
KLOTZI_DISABLED_SKILLS=

# ─── Server / Activity ──────────────────────────────────────
PORT=3001
# Geheimer Schlüssel, um Klotzi auch außerhalb von Discord anzuschauen (Browser/OBS):
#   https://dein-host/?guild=<GUILD_ID>&key=<KLOTZI_OVERLAY_KEY>&transparent=1
KLOTZI_OVERLAY_KEY=
KLOTZI_DATA_DIR=data
# KLOTZI_DEBUG=true
