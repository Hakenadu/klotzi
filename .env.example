# ─── Discord ────────────────────────────────────────────────
# https://discord.com/developers/applications → deine App
DISCORD_TOKEN=                 # Bot → Reset Token
DISCORD_CLIENT_ID=             # OAuth2 → Client ID
DISCORD_CLIENT_SECRET=         # OAuth2 → Client Secret (für die Activity nötig)
# Optional: Slash-Commands nur in dieser Guild registrieren (sofort verfügbar, ideal zum Entwickeln)
DISCORD_GUILD_ID=

# ─── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Obergrenze für Ausgabe-Tokens inkl. Reasoning
# OPENAI_MAX_TOKENS=2000
# Reasoning-Aufwand: none, minimal, low, medium, high … (leer = Modell-Standard)
# OPENAI_REASONING_EFFORT=low
# OPENAI_BASE_URL=             # für kompatible APIs / Proxys
# Modell für die Decisions API (Nachlauschen) – derzeit nur gpt-6-luna
# OPENAI_DECISION_MODEL=gpt-6-luna

# ─── Klotzis Verhalten ──────────────────────────────────────
# Kanäle (IDs, kommagetrennt), in denen Klotzi auf JEDE Nachricht antwortet
KLOTZI_CHAT_CHANNELS=
# Reagiert, wenn "Klotzi" in einer Nachricht vorkommt
KLOTZI_RESPOND_TO_NAME=true
# Wahrscheinlichkeit für spontane Reaktionen (Emoji + Animation) auf andere Nachrichten
KLOTZI_AMBIENT_CHANCE=0.15
KLOTZI_AMBIENT_COOLDOWN=60
# Kontext für spontane Reaktionen und das Nachlauschen (Anzahl Nachrichten)
KLOTZI_HISTORY_LIMIT=15
KLOTZI_USER_COOLDOWN=3
# Für Antworten sieht Klotzi den ganzen Verlauf dieser letzten Stunden …
KLOTZI_HISTORY_HOURS=24
# … aber höchstens so viele Nachrichten / Zeichen
# KLOTZI_HISTORY_MAX_MESSAGES=500
# KLOTZI_HISTORY_MAX_CHARS=60000
# Nach eigener Antwort noch N Nachrichten mitlauschen (Decisions API) …
KLOTZI_FOLLOW_UP_MESSAGES=2
# … höchstens so viele Minuten lang (0 = unbegrenzt)
KLOTZI_FOLLOW_UP_MINUTES=15
# Ab dieser Wahrscheinlichkeit (0–1) antwortet Klotzi
KLOTZI_FOLLOW_UP_THRESHOLD=0.5

# ─── Gedächtnis (data/MEMORY.md) ────────────────────────────
# Ist es voll, verdrängt Klotzi die unwichtigsten / ältesten Erinnerungen
KLOTZI_MEMORY_MAX_ENTRIES=80
KLOTZI_MEMORY_MAX_CHARS=8000

# ─── Skills ─────────────────────────────────────────────────
# Nur diese Skills laden (leer = alle)
KLOTZI_SKILLS=
# Diese Skills nicht laden
KLOTZI_DISABLED_SKILLS=

# ─── Sprach-Chat (Skill "voice") ────────────────────────────
# Nur diese Sprach-Channels betreten (IDs, kommagetrennt; leer = alle erlaubten)
KLOTZI_VOICE_CHANNELS=
# Geräusche im Sprach-Channel abspielen
KLOTZI_VOICE_SOUNDS=true
# Lautstärke 0–1
KLOTZI_VOICE_VOLUME=0.35

# ─── Einladung zur Activity (Skill "invite") ────────────────
# Beim Start eines Sprach-Chats fragt Klotzi per Klick-Link, ob er mitmachen darf
KLOTZI_VOICE_INVITE=true
# Kanal-ID für die Frage (leer = Text-Chat des Sprach-Channels)
KLOTZI_VOICE_INVITE_CHANNEL=
# Frühestens nach so vielen Minuten im selben Channel erneut fragen
KLOTZI_VOICE_INVITE_COOLDOWN=10

# ─── Server / Activity ──────────────────────────────────────
PORT=3001
# Geheimer Schlüssel, um Klotzi auch außerhalb von Discord anzuschauen (Browser/OBS):
#   https://dein-host/?guild=<GUILD_ID>&key=<KLOTZI_OVERLAY_KEY>&transparent=1
KLOTZI_OVERLAY_KEY=
KLOTZI_DATA_DIR=data
# KLOTZI_DEBUG=true
